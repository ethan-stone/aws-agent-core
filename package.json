{
  "name": "agent-core",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "agent-core": "bin/agent-core.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:api": "pnpm --filter @agent-core/api test",
    "cdk": "cdk",
    "mongodb:dev": "docker compose up mongodb",
    "mongodb:dev:detached": "docker compose up -d mongodb",
    "mongodb:stop": "docker compose stop mongodb",
    "api:seed:local": "pnpm --filter @agent-core/api seed",
    "api:dev:local": "pnpm --filter @agent-core/api dev",
    "webapp:dev:local": "pnpm --filter @agent-core/webapp dev",
    "dev:api": "pnpm --filter @agent-core/api dev",
    "seed:api": "pnpm --filter @agent-core/api seed",
    "dev:webapp": "pnpm --filter @agent-core/webapp dev"
  },
  "devDependencies": {
    "@aws-cdk/aws-bedrock-agentcore-alpha": "2.250.0-alpha.0",
    "@aws-cdk/aws-bedrock-alpha": "2.250.0-alpha.0",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1118.0",
    "jest": "^30",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.250.0",
    "constructs": "^10.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@aws/agentcore",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
