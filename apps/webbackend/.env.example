# PulseForge web backend local development

API_PORT=3000
API_LOG_LEVEL=debug

# Persistence
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=pulseforge

# Agent invocation
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/example
AGENT_RUNTIME_QUALIFIER=DEFAULT

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=your-aws-profile

# App auth
# Reuse the shared Cognito user pool created by the CDK stack.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_USER_POOL_CLIENT_ID=exampleclientid

# Delegated agent/tool auth
# /tools/* rejects normal web app client tokens and only accepts tokens from
# these Cognito app clients with pulseforge-backend/* scopes.
COGNITO_TOOLS_CLIENT_IDS=exampletoolsclientid
COGNITO_RESOURCE_SERVER_IDENTIFIER=pulseforge-backend
