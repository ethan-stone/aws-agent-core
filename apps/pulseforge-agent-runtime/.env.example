# Local agent runtime development

AWS_REGION=us-east-1
AWS_PROFILE=your-aws-profile

# Optional. When unset, the runtime uses in-process local memory.
# MEMORY_ID=memory-xxxxxxxxxxxxxxxx

# Optional. Enable namespace-based long-term memory retrieval before model calls.
ENABLE_AGENTCORE_LONG_TERM_MEMORY=false

# Optional. Override the XML-style tag used for injected long-term memory context.
AGENTCORE_MEMORY_CONTEXT_TAG=agentcore-memory-context

# Optional OAuth callback override for local testing.
# OAUTH_CALLBACK_URL=http://localhost:9090/oauth2/callback

# Local container/runtime settings
LOCAL_AGENT_BASE_URL=http://127.0.0.1:8080
AGENT_CONTAINER_NAME=pulseforge-agent-local
