# Local agent runtime development

AWS_REGION=us-east-1
AWS_PROFILE=your-aws-profile

# Optional. When unset, the runtime uses in-process local memory.
# MEMORY_ID=memory-xxxxxxxxxxxxxxxx

# Optional. Enable namespace-based long-term memory retrieval before model calls.
ENABLE_AGENTCORE_LONG_TERM_MEMORY=false

# Optional. Override the XML-style tag used for injected long-term memory context.
AGENTCORE_MEMORY_CONTEXT_TAG=agentcore-memory-context

# Optional. Configure HTTP tools from the runtime to the PulseForge web backend.
# Deployed CDK environments require this to avoid accidentally running without tools.
# PULSEFORGE_TOOLS_API_URL=http://localhost:3001
# PULSEFORGE_REQUIRE_TOOLS=false
# PULSEFORGE_TOOL_AUTH_MODE=agentcore-runtime
# PULSEFORGE_TOOLS_PROVIDER_NAME=pulseforge-backend-user-federation
# PULSEFORGE_TOOLS_RESOURCE_SERVER_IDENTIFIER=pulseforge-backend

# Local-only delegated tool auth. Required when PULSEFORGE_TOOL_AUTH_MODE=local-user-id.
# PULSEFORGE_WORKLOAD_NAME=pulseforge-agent-runtime
# PULSEFORGE_LOCAL_USER_ID=local-cognito-user-sub

# Optional post-auth return URL for delegated tool auth.
# This is where AgentCore redirects the browser after token retrieval completes.
# It is not the AgentCore OAuth provider callback URL registered with Cognito.
# OAUTH_CALLBACK_URL=http://localhost:5173/oauth2/callback

# Local container/runtime settings
LOCAL_AGENT_BASE_URL=http://127.0.0.1:8080
AGENT_CONTAINER_NAME=pulseforge-agent-local
