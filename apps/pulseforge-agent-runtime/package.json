{
  "name": "@agent-core/pulseforge-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "node --import tsx --test src/**/*.test.ts",
    "start": "node dist/index.mjs",
    "dev": "node --import tsx src/index.ts",
    "invoke:local": "node --import tsx src/scripts/invoke-local.ts"
  },
  "dependencies": {
    "@agent-core/pulseforge-agent": "workspace:*",
    "@agent-core/pulseforge-backend": "workspace:*",
    "@agent-core/pulseforge-domain": "workspace:*",
    "@agent-core/pulseforge-tools": "workspace:*",
    "@aws-sdk/client-bedrock-agentcore": "^3.1038.0",
    "@aws-sdk/client-secrets-manager": "^3.1043.0",
    "@aws-sdk/credential-providers": "^3.1038.0",
    "@aws/aws-distro-opentelemetry-node-autoinstrumentation": "^0.9.0",
    "@smithy/protocol-http": "^5.3.14",
    "@strands-agents/sdk": "1.3.0",
    "aws-jwt-verify": "^5.1.0",
    "bedrock-agentcore": "^0.2.2",
    "dotenv": "^17.4.2",
    "langchain": "^1.3.5",
    "mongodb": "^6.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
